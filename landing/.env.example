# ─────────────────────────────────────────────────────────────────────────────
#  Mr GUEHEDI Emmanuel — Landing page & lead generation system
#  Copy this file to `.env.local` and fill in real values. NEVER commit .env.local
#  Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public URL, no trailing slash. Used for canonical tags, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Database — Supabase / PostgreSQL  (REQUIRES EXTERNAL CONFIGURATION) ──────
# Project settings → API. The SERVICE_ROLE key is server-only: never prefix it
# with NEXT_PUBLIC_. Without these the API falls back to a local JSONL file
# (dev only) so the form still works end-to-end while you set Supabase up.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional: direct Postgres connection string, for migrations / BI tools only.
DATABASE_URL=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Password used to sign in to the lead dashboard.
ADMIN_PASSWORD=
# Random 32+ char string used to sign the admin session cookie.
# Generate with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Optional machine-to-machine token for GET/PATCH/DELETE /api/leads
# (send as `Authorization: Bearer <token>`), for Make / Zapier / n8n.
LEADS_API_TOKEN=

# ── Email notifications  (REQUIRES EXTERNAL CONFIGURATION) ───────────────────
# Choose ONE provider: "resend" | "brevo" | "none"
EMAIL_PROVIDER=none
EMAIL_API_KEY=
# Verified sender for your provider, e.g. "Emmanuel <noreply@yourdomain.com>"
EMAIL_FROM=
# Where new-lead alerts are sent.
EMAIL_NOTIFY_TO=christguimeni@gmail.com
# Send an automatic confirmation email to the prospect (true/false)
EMAIL_SEND_CONFIRMATION=false

# ── Outbound webhook (Make / Zapier / n8n / HubSpot) — optional ──────────────
# Every accepted lead is POSTed as JSON to this URL.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ── Anti-spam — Cloudflare Turnstile (optional but recommended) ──────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Marketing & analytics tags (optional, placeholders below) ────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# ── Search Console / verification (optional) ────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
